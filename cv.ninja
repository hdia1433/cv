# cv project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_clang
  command = clang $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_clang
  command = clang++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_clang
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule link_clang
  command = clang++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_clang
  command = clang++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: cv_Debug

cflags_cv_Debug = -arch arm64 -g -D"DEBUG" -Isrc/headers -std=c++23
cxxflags_cv_Debug = -arch arm64 -g -std=c++23 -D"DEBUG" -Isrc/headers -std=c++23
ldflags_cv_Debug = -arch arm64
objdir_cv_Debug = bin-int/Debug
targetdir_cv_Debug = bin/Debug
target_cv_Debug = cv

build bin-int/Debug/controller.o: cxx_clang src/controller/controller.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/main.o: cxx_clang src/controller/main.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/pch.o: cxx_clang src/controller/pch.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/helpers.o: cxx_clang src/helpers/helpers.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/asmGenerator.o: cxx_clang src/model/asmGenerator.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/iRGenerator.o: cxx_clang src/model/iRGenerator.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/instruction.o: cxx_clang src/model/instruction.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/lexer.o: cxx_clang src/model/lexer.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/node.o: cxx_clang src/model/node.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/optimizer.o: cxx_clang src/model/optimizer.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/parser.o: cxx_clang src/model/parser.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/semanticAnalyser.o: cxx_clang src/model/semanticAnalyser.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/symbol.o: cxx_clang src/model/symbol.cpp
  cxxflags = $cxxflags_cv_Debug
build bin-int/Debug/type.o: cxx_clang src/model/type.cpp
  cxxflags = $cxxflags_cv_Debug
build bin/Debug/cv: link_clang bin-int/Debug/controller.o bin-int/Debug/main.o bin-int/Debug/pch.o bin-int/Debug/helpers.o bin-int/Debug/asmGenerator.o bin-int/Debug/iRGenerator.o bin-int/Debug/instruction.o bin-int/Debug/lexer.o bin-int/Debug/node.o bin-int/Debug/optimizer.o bin-int/Debug/parser.o bin-int/Debug/semanticAnalyser.o bin-int/Debug/symbol.o bin-int/Debug/type.o
  ldflags = $ldflags_cv_Debug
build bin-int/Debug/cv.postbuild: postbuild | bin/Debug/cv
  postbuildcommands = sh -c 'ninja -t compdb > compile_commands.json && touch "bin-int/Debug/cv.postbuild"'


build bin/Release/cv: link_clang bin-int/Release/controller.o bin-int/Release/main.o bin-int/Release/pch.o bin-int/Release/helpers.o bin-int/Release/asmGenerator.o bin-int/Release/iRGenerator.o bin-int/Release/instruction.o bin-int/Release/lexer.o bin-int/Release/node.o bin-int/Release/optimizer.o bin-int/Release/parser.o bin-int/Release/semanticAnalyser.o bin-int/Release/symbol.o bin-int/Release/type.o
  ldflags = $ldflags_cv_Release

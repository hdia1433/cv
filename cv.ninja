  postbuildcommands = sh -c 'ninja -t compdb > compile_commands.json && touch "bin-int/Release/cv.postbuild"'

# Build targets

build cv_Debug: phony bin-int/Debug/cv.postbuild
build cv_Release: phony bin-int/Release/cv.postbuild

# Project phony targets

build cv: phony bin/Debug/cv.postbuild

